      <CheatEntries>
        <CheatEntry><ID>9500</ID><Description>"AUTO-FIND POINTERS   [enable AFTER the main script - fills rows without waiting]"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if getOpenedProcessID()==0 then openProcess("KeepDriving.exe") end

--[[ Keep Driving - automatic pointer finder.

The master script waits for the game to READ a variable before a row can aim.
This finds the pointers directly instead: it captures the stats object, walks the
variable hash map inside it, and writes each variable's live RValue address into
the kdP_&lt;name&gt; slot the master script already allocated. Rows and the diagnostics
group keep working unchanged - they just fill in immediately, and they fill in for
variables the game never reads.

Map layout (read out of the game's own lookup routine):
    object + 0x48         -&gt; hash map
    map    + 0x08         -&gt; bucket mask  (capacity-1)
    map    + 0x10         -&gt; bucket array, 16 bytes per entry
    entry  + 0x00         -&gt; RValue*  (the variable's storage)
    entry  + 0x0C         -&gt; key, which is (varid + 1) with bit 31 cleared
    key == 0              -&gt; empty bucket
RValue: value at +0, kind at +12. kind 0 = real number, 2 = array.
]]

-- Cheat Engine scans this entire script for its section markers, so the words
-- must never appear as literal text here. Build them at runtime instead.
local NL = string.char(10)
local EN = "[EN" .. "ABLE]" .. NL
local DIS = NL .. "[DIS" .. "ABLE]" .. NL

kdAF = kdAF or {}

kdAF.NAMES = {
  "money","gas","gas_max","energy","energy_max","energy_max_normal","car_health",
  "car_health_max","skill_points","day","time_hour","time_minute","month","day_max",
  "road_level","threat","threat_max","enemy_level","card_rarity","experience","exp_max",
  "level","level_max","items","item_charges","gb_items","gb_item_charges","item_price",
  "upg_price","cost_per_gas","rep_cost_per_durability","money_cost_mod","gas_cost_mod",
  "energy_cost_mod","durability_cost_mod","gas_drain","pay","work_pay","work_cost",
  "work_time","ailments","ailments_max","ailment_timer","ailment_timer_max",
  "tired_stacks","hh_active","hh_level","seat_active","explore_bags","explore_places",
  "quests","car_speed",
}

-- module offset of each variable's id field in the .data name table
kdAF.OFF = {
  money=0x1B66C98, gas=0x1B66C78, gas_max=0x1B65B08, energy=0x1B65D78,
  energy_max=0x1B65CA8, energy_max_normal=0x1B65938, car_health=0x1B66CD8,
  car_health_max=0x1B65A08, skill_points=0x1B74FF8, day=0x1B6DD18,
  time_hour=0x1B79868, time_minute=0x1B79848, month=0x1B6DC38, day_max=0x1B57A18,
  road_level=0x1BC80D0, threat=0x1B5A188, threat_max=0x1B5B068, enemy_level=0x1B70B98,
  card_rarity=0x1B5A9F8, experience=0x1B6E138, exp_max=0x1B758F8, level=0x1B565D8,
  level_max=0x1B75988, items=0x1B65E68, item_charges=0x1B70ED8, gb_items=0x1B75458,
  gb_item_charges=0x1B76028, item_price=0x1B8DE58, upg_price=0x1B74508,
  cost_per_gas=0x1BCAB80, rep_cost_per_durability=0x1BCA080, money_cost_mod=0x1B61B88,
  gas_cost_mod=0x1B61B78, energy_cost_mod=0x1B61BE8, durability_cost_mod=0x1B61BB8,
  gas_drain=0x1B61EF8, pay=0x1B74E48, work_pay=0x1B68188, work_cost=0x1B680E8,
  work_time=0x1B68218, ailments=0x1B65D28, ailments_max=0x1B65E08,
  ailment_timer=0x1B65D18, ailment_timer_max=0x1B65E18, tired_stacks=0x1B65CD8,
  hh_active=0x1B62F28, hh_level=0x1B6E448, seat_active=0x1B75E18,
  explore_bags=0x1B72DE8, explore_places=0x1B77EC8, quests=0x1B65C08,
  car_speed=0x1B78318,
}

-- signature for:  call FindSlot / mov r12,[..] / mov rcx,rbp ...
-- we hook at +5, where rax = the slot just found and rbp = the object owning it
kdAF.AOB = "E8 ?? ?? ?? ?? 4C 8B 25 ?? ?? ?? ?? 48 8B CD 44 0F B6 BC 24 80 00 00 00 48 8B F8"
kdAF.R12OFF = "1BDA2A0"


local function modbase()
  return getAddress("KeepDriving.exe")
end

function kdAF.varid(name)
  local off = kdAF.OFF[name]
  if not off then return nil end
  return readInteger(modbase() + off)
end

-- Install the object-capture hook. Anchors on `gas`, which the game reads early.
function kdAF.installHook()
  if (getAddress("kdObjStats") or 0) ~= 0 then return true end
  local gid = kdAF.varid("gas")
  if not gid then return false, "cannot read the gas variable id" end

  local data = EN ..
    "aobscanmodule(kdAFsite,KeepDriving.exe," .. kdAF.AOB .. ")" .. NL ..
    "alloc(kdAFmem,$100,kdAFsite)" .. NL ..
    "label(kdObjStats)" .. NL ..
    "registersymbol(kdAFsite)" .. NL ..
    "registersymbol(kdObjStats)" .. NL ..
    "kdAFmem:" .. NL ..
    "kdObjStats:" .. NL ..
    "  dq 0" .. DIS
  if not autoAssemble(data) then return false, "could not allocate the capture slot" end

  -- never install a store against a symbol that failed to register: it would
  -- assemble as  mov [0],rbp  and crash the game on the next lookup
  if (getAddress("kdObjStats") or 0) == 0 then return false, "kdObjStats did not register" end

  -- NOTE: literals in Cheat Engine's assembler are HEX, so the id is formatted %X
  local hook = EN ..
    "alloc(kdAFcode,$200,kdAFsite)" .. NL ..
    "label(kdAFhook)" .. NL ..
    "label(kdAFret)" .. NL ..
    "label(kdAFdone)" .. NL ..
    "registersymbol(kdAFcode)" .. NL ..
    "kdAFcode:" .. NL ..
    "kdAFhook:" .. NL ..
    "  pushfq" .. NL ..
    "  test rax,rax" .. NL ..
    "  je kdAFdone" .. NL ..
    string.format("  cmp esi,%X", gid) .. NL ..
    "  jne kdAFdone" .. NL ..
    "  mov [kdObjStats],rbp" .. NL ..
    "kdAFdone:" .. NL ..
    "  popfq" .. NL ..
    "  mov r12,[KeepDriving.exe+" .. kdAF.R12OFF .. "]" .. NL ..
    "  mov rcx,rbp" .. NL ..
    "  jmp kdAFret" .. NL ..
    NL ..
    "kdAFsite+5:" .. NL ..
    "  jmp kdAFhook" .. NL ..
    "  nop 5" .. NL ..
    "kdAFret:" .. DIS
  if not autoAssemble(hook) then return false, "could not install the capture hook" end
  return true
end

function kdAF.removeHook()
  if (getAddress("kdAFsite") or 0) == 0 then return end
  autoAssemble(EN ..
    "kdAFsite+5:" .. NL ..
    "  mov r12,[KeepDriving.exe+" .. kdAF.R12OFF .. "]" .. NL ..
    "  mov rcx,rbp" .. DIS)
  for _, s in ipairs({ "kdAFcode", "kdObjStats", "kdAFsite" }) do
    autoAssemble(EN .. "unregistersymbol(" .. s .. ")" .. DIS)
  end
end

-- Walk one object's variable map -&gt; { [varid] = RValue* }, count
function kdAF.walk(obj)
  if not obj or obj == 0 then return nil end
  local map = readQword(obj + 0x48)
  if not map or map == 0 then return nil end
  local mask = readInteger(map + 8)
  local buckets = readQword(map + 0x10)
  if not mask or not buckets or buckets == 0 or mask &lt;= 0 or mask &gt; 0x100000 then
    return nil
  end
  local slots, n = {}, 0
  for i = 0, mask do
    local e = buckets + i * 16
    local key = readInteger(e + 0xC)
    if key and key ~= 0 then
      local v = readQword(e)
      if v and v ~= 0 then
        slots[key - 1] = v
        n = n + 1
      end
    end
  end
  return slots, n
end

-- Resolve every row and poke the address into the master script's kdP_ slot.
-- Only real numbers (kind 0) are assigned; an array would render as garbage in
-- a Double row, so those are reported and left alone.
function kdAF.resolve()
  if (getAddress("kdP_gas") or 0) == 0 then
    return nil, "enable the main script first - the kdP_ slots do not exist yet"
  end
  local obj = readQword(getAddress("kdObjStats") or 0)
  if not obj or obj == 0 then
    return nil, "no stats object captured yet - load a save and give it a moment"
  end
  local slots, n = kdAF.walk(obj)
  if not slots then return nil, "the captured object has no readable variable map" end

  local assigned, arrays, absent = {}, {}, {}
  for _, name in ipairs(kdAF.NAMES) do
    local sym = getAddress("kdP_" .. name)
    local id = kdAF.varid(name)
    local slot = id and slots[id] or nil
    if slot then
      local kind = readInteger(slot + 12)
      if kind == 0 then
        if sym and sym ~= 0 then writeQword(sym, slot) end
        assigned[#assigned + 1] = name
      else
        arrays[#arrays + 1] = name .. "(kind" .. tostring(kind) .. ")"
      end
    else
      absent[#absent + 1] = name
    end
  end
  return { total = n, assigned = assigned, arrays = arrays, absent = absent, obj = obj }
end

function kdAF.stop()
  if kdAF.timer then
    kdAF.timer.Enabled = false
    kdAF.timer.Destroy()
    kdAF.timer = nil
  end
end

function kdAF.start(intervalMs)
  kdAF.stop()
  local ok, err = kdAF.installHook()
  if not ok then return false, err end
  kdAF.timer = createTimer(nil, false)
  kdAF.timer.Interval = intervalMs or 2000
  kdAF.timer.OnTimer = function() kdAF.resolve() end
  kdAF.timer.Enabled = true
  return true
end


local ok, err = kdAF.start(2000)
if not ok then error(tostring(err)) end
local res = kdAF.resolve()
if res then
  print(string.format("[auto-find] object %X, %d live variables, %d rows assigned, %d arrays skipped, %d not in this object",
        res.obj, res.total, #res.assigned, #res.arrays, #res.absent))
else
  print("[auto-find] armed - rows will fill in as soon as a save is loaded")
end
{$asm}

