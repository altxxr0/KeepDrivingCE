        <CheatEntry>
          <ID>1055</ID>
          <Description>"=== GAME SPEED (slowing only - 2x/4x removed, measured no effect) ==="</Description>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>1056</ID>
              <Description>"Slow motion 0.25x   [measured: 0.30x of normal]"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if getOpenedProcessID()==0 then openProcess("KeepDriving.exe") end
speedhack_setSpeed(0.25)
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
speedhack_setSpeed(1)
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>1057</ID>
              <Description>"Half speed 0.5x   [same mechanism as 0.25x, not separately measured]"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if getOpenedProcessID()==0 then openProcess("KeepDriving.exe") end
speedhack_setSpeed(0.5)
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
speedhack_setSpeed(1)
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>1060</ID>
              <Description>"Normal speed 1x (reset)"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if getOpenedProcessID()==0 then openProcess("KeepDriving.exe") end
speedhack_setSpeed(1)
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
speedhack_setSpeed(1)
{$asm}
</AssemblerScript>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
