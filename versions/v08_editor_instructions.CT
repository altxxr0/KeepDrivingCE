      <CheatEntries>
        <CheatEntry><ID>9500</ID><Description>"AUTO-FIND POINTERS   [enable AFTER the main script - fills rows without waiting]"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if getOpenedProcessID()==0 then openProcess("KeepDriving.exe") end

--[[ Keep Driving - automatic pointer finder.

The master script waits for the game to READ a variable before a row can aim.
This finds the pointers directly instead: it captures the stats object, walks the
variable hash map inside it, and writes each variable's live RValue address into
the kdP_&lt;name&gt; slot the master script already allocated. Rows and the diagnostics
group keep working unchanged - they just fill in immediately, and they fill in for
variables the game never reads.

Map layout (read out of the game's own lookup routine):
    object + 0x48         -&gt; hash map
    map    + 0x08         -&gt; bucket mask  (capacity-1)
    map    + 0x10         -&gt; bucket array, 16 bytes per entry
    entry  + 0x00         -&gt; RValue*  (the variable's storage)
    entry  + 0x0C         -&gt; key, which is (varid + 1) with bit 31 cleared
    key == 0              -&gt; empty bucket
RValue: value at +0, kind at +12. kind 0 = real number, 2 = array.
]]

-- Cheat Engine scans this entire script for its section markers, so the words
-- must never appear as literal text here. Build them at runtime instead.
local NL = string.char(10)
local EN = "[EN" .. "ABLE]" .. NL
local DIS = NL .. "[DIS" .. "ABLE]" .. NL

kdAF = kdAF or {}

kdAF.NAMES = {
  "money","gas","gas_max","energy","energy_max","energy_max_normal","car_health",
  "car_health_max","skill_points","day","time_hour","time_minute","month","day_max",
  "road_level","threat","threat_max","enemy_level","card_rarity","experience","exp_max",
  "level","level_max","items","item_charges","gb_items","gb_item_charges","item_price",
  "upg_price","cost_per_gas","rep_cost_per_durability","money_cost_mod","gas_cost_mod",
  "energy_cost_mod","durability_cost_mod","gas_drain","pay","work_pay","work_cost",
  "work_time","ailments","ailments_max","ailment_timer","ailment_timer_max",
  "tired_stacks","hh_active","hh_level","seat_active","explore_bags","explore_places",
  "quests","car_speed",
}

-- module offset of each variable's id field in the .data name table
kdAF.OFF = {
  money=0x1B66C98, gas=0x1B66C78, gas_max=0x1B65B08, energy=0x1B65D78,
  energy_max=0x1B65CA8, energy_max_normal=0x1B65938, car_health=0x1B66CD8,
  car_health_max=0x1B65A08, skill_points=0x1B74FF8, day=0x1B6DD18,
  time_hour=0x1B79868, time_minute=0x1B79848, month=0x1B6DC38, day_max=0x1B57A18,
  road_level=0x1BC80D0, threat=0x1B5A188, threat_max=0x1B5B068, enemy_level=0x1B70B98,
  card_rarity=0x1B5A9F8, experience=0x1B6E138, exp_max=0x1B758F8, level=0x1B565D8,
  level_max=0x1B75988, items=0x1B65E68, item_charges=0x1B70ED8, gb_items=0x1B75458,
  gb_item_charges=0x1B76028, item_price=0x1B8DE58, upg_price=0x1B74508,
  cost_per_gas=0x1BCAB80, rep_cost_per_durability=0x1BCA080, money_cost_mod=0x1B61B88,
  gas_cost_mod=0x1B61B78, energy_cost_mod=0x1B61BE8, durability_cost_mod=0x1B61BB8,
  gas_drain=0x1B61EF8, pay=0x1B74E48, work_pay=0x1B68188, work_cost=0x1B680E8,
  work_time=0x1B68218, ailments=0x1B65D28, ailments_max=0x1B65E08,
  ailment_timer=0x1B65D18, ailment_timer_max=0x1B65E18, tired_stacks=0x1B65CD8,
  hh_active=0x1B62F28, hh_level=0x1B6E448, seat_active=0x1B75E18,
  explore_bags=0x1B72DE8, explore_places=0x1B77EC8, quests=0x1B65C08,
  car_speed=0x1B78318,
}

-- signature for:  call FindSlot / mov r12,[..] / mov rcx,rbp ...
-- we hook at +5, where rax = the slot just found and rbp = the object owning it
kdAF.AOB = "E8 ?? ?? ?? ?? 4C 8B 25 ?? ?? ?? ?? 48 8B CD 44 0F B6 BC 24 80 00 00 00 48 8B F8"
kdAF.R12OFF = "1BDA2A0"


local function modbase()
  return getAddress("KeepDriving.exe")
end

function kdAF.varid(name)
  local off = kdAF.OFF[name]
  if not off then return nil end
  return readInteger(modbase() + off)
end

-- Install the object-capture hook. Anchors on `gas`, which the game reads early.
function kdAF.installHook()
  if (getAddress("kdObjStats") or 0) ~= 0 then return true end
  local gid = kdAF.varid("gas")
  if not gid then return false, "cannot read the gas variable id" end

  local data = EN ..
    "aobscanmodule(kdAFsite,KeepDriving.exe," .. kdAF.AOB .. ")" .. NL ..
    "alloc(kdAFmem,$100,kdAFsite)" .. NL ..
    "label(kdObjStats)" .. NL ..
    "registersymbol(kdAFsite)" .. NL ..
    "registersymbol(kdObjStats)" .. NL ..
    "kdAFmem:" .. NL ..
    "kdObjStats:" .. NL ..
    "  dq 0" .. DIS
  if not autoAssemble(data) then return false, "could not allocate the capture slot" end

  -- never install a store against a symbol that failed to register: it would
  -- assemble as  mov [0],rbp  and crash the game on the next lookup
  if (getAddress("kdObjStats") or 0) == 0 then return false, "kdObjStats did not register" end

  -- NOTE: literals in Cheat Engine's assembler are HEX, so the id is formatted %X
  local hook = EN ..
    "alloc(kdAFcode,$200,kdAFsite)" .. NL ..
    "label(kdAFhook)" .. NL ..
    "label(kdAFret)" .. NL ..
    "label(kdAFdone)" .. NL ..
    "registersymbol(kdAFcode)" .. NL ..
    "kdAFcode:" .. NL ..
    "kdAFhook:" .. NL ..
    "  pushfq" .. NL ..
    "  test rax,rax" .. NL ..
    "  je kdAFdone" .. NL ..
    string.format("  cmp esi,%X", gid) .. NL ..
    "  jne kdAFdone" .. NL ..
    "  mov [kdObjStats],rbp" .. NL ..
    "kdAFdone:" .. NL ..
    "  popfq" .. NL ..
    "  mov r12,[KeepDriving.exe+" .. kdAF.R12OFF .. "]" .. NL ..
    "  mov rcx,rbp" .. NL ..
    "  jmp kdAFret" .. NL ..
    NL ..
    "kdAFsite+5:" .. NL ..
    "  jmp kdAFhook" .. NL ..
    "  nop 5" .. NL ..
    "kdAFret:" .. DIS
  if not autoAssemble(hook) then return false, "could not install the capture hook" end
  return true
end

function kdAF.removeHook()
  if (getAddress("kdAFsite") or 0) == 0 then return end
  autoAssemble(EN ..
    "kdAFsite+5:" .. NL ..
    "  mov r12,[KeepDriving.exe+" .. kdAF.R12OFF .. "]" .. NL ..
    "  mov rcx,rbp" .. DIS)
  for _, s in ipairs({ "kdAFcode", "kdObjStats", "kdAFsite" }) do
    autoAssemble(EN .. "unregistersymbol(" .. s .. ")" .. DIS)
  end
end

-- Walk one object's variable map -&gt; { [varid] = RValue* }, count
function kdAF.walk(obj)
  if not obj or obj == 0 then return nil end
  local map = readQword(obj + 0x48)
  if not map or map == 0 then return nil end
  local mask = readInteger(map + 8)
  local buckets = readQword(map + 0x10)
  if not mask or not buckets or buckets == 0 or mask &lt;= 0 or mask &gt; 0x100000 then
    return nil
  end
  local slots, n = {}, 0
  for i = 0, mask do
    local e = buckets + i * 16
    local key = readInteger(e + 0xC)
    if key and key ~= 0 then
      local v = readQword(e)
      if v and v ~= 0 then
        slots[key - 1] = v
        n = n + 1
      end
    end
  end
  return slots, n
end

-- Resolve every row and poke the address into the master script's kdP_ slot.
-- Only real numbers (kind 0) are assigned; an array would render as garbage in
-- a Double row, so those are reported and left alone.
function kdAF.resolve()
  if (getAddress("kdP_gas") or 0) == 0 then
    return nil, "enable the main script first - the kdP_ slots do not exist yet"
  end
  local obj = readQword(getAddress("kdObjStats") or 0)
  if not obj or obj == 0 then
    return nil, "no stats object captured yet - load a save and give it a moment"
  end
  local slots, n = kdAF.walk(obj)
  if not slots then return nil, "the captured object has no readable variable map" end

  local assigned, arrays, absent = {}, {}, {}
  for _, name in ipairs(kdAF.NAMES) do
    local sym = getAddress("kdP_" .. name)
    local id = kdAF.varid(name)
    local slot = id and slots[id] or nil
    if slot then
      local kind = readInteger(slot + 12)
      if kind == 0 then
        if sym and sym ~= 0 then writeQword(sym, slot) end
        assigned[#assigned + 1] = name
      else
        arrays[#arrays + 1] = name .. "(kind" .. tostring(kind) .. ")"
      end
    else
      absent[#absent + 1] = name
    end
  end
  return { total = n, assigned = assigned, arrays = arrays, absent = absent, obj = obj }
end

function kdAF.stop()
  if kdAF.timer then
    kdAF.timer.Enabled = false
    kdAF.timer.Destroy()
    kdAF.timer = nil
  end
end

function kdAF.start(intervalMs)
  kdAF.stop()
  local ok, err = kdAF.installHook()
  if not ok then return false, err end
  kdAF.timer = createTimer(nil, false)
  kdAF.timer.Interval = intervalMs or 2000
  kdAF.timer.OnTimer = function() kdAF.resolve() end
  kdAF.timer.Enabled = true
  return true
end

-- On-demand summary. Kept separate from enabling because CE's print() forces the
-- Lua Engine window open, which fights with Compact mode.
function kdAF.report()
  local res, err = kdAF.resolve()
  if not res then print("[auto-find] " .. tostring(err)) return end
  print(string.format("[auto-find] object %X, %d live variables in its map", res.obj, res.total))
  print(string.format("  assigned %d: %s", #res.assigned, table.concat(res.assigned, ", ")))
  print(string.format("  arrays skipped %d: %s", #res.arrays, table.concat(res.arrays, ", ")))
  print(string.format("  not in this object %d: %s", #res.absent, table.concat(res.absent, ", ")))
end


local ok, err = kdAF.start(2000)
if not ok then error(tostring(err)) end
kdAF.resolve()
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if kdAF then kdAF.stop() kdAF.removeHook() end
{$asm}
</AssemblerScript></CheatEntry><CheatEntry><ID>9501</ID><Description>"COMPACT MODE   [hides the memory scanner - cheat table only]"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

--[[ Keep Driving - Compact mode.

Hides Cheat Engine's memory-scanning UI and leaves just the cheat table.

The main form is only four top-level controls:
    Panel5      alTop     the whole scanner - New Scan, value/scan type, scan
                          options, the found-address list, Memory View
    Splitter1             the drag divider under it
    Panel1      alClient  holds the AddressList: this is the cheat table
    Panel4      alBottom  Advanced Options / Table Extras
Because Panel1 is alClient it expands to fill the form on its own once Panel5
and the splitter are hidden - no repositioning needed.

The menu bar stays, so File / Table / Edit still work. Panel4 stays too, since
those buttons belong to the table rather than the scanner.
]]

kdCM = kdCM or {}

kdCM.WIDTH = 600
kdCM.HEIGHT = 560

local function parts()
  local mf = getMainForm()
  if not mf then return nil end
  local ok, p5 = pcall(function() return mf.Panel5 end)
  local ok2, sp = pcall(function() return mf.Splitter1 end)
  if not ok or not ok2 or p5 == nil or sp == nil then return nil end
  return mf, p5, sp
end

function kdCM.on(w, h)
  if kdCM.saved then return true end
  local mf, p5, sp = parts()
  if not mf then
    return false, "this Cheat Engine build does not expose Panel5/Splitter1 - compact mode needs CE 7.x"
  end
  kdCM.saved = {
    p5 = p5.Visible, sp = sp.Visible,
    L = mf.Left, T = mf.Top, W = mf.Width, H = mf.Height,
  }
  p5.Visible = false
  sp.Visible = false
  mf.Width = w or kdCM.WIDTH
  mf.Height = h or kdCM.HEIGHT
  return true
end

function kdCM.off()
  local s = kdCM.saved
  if not s then return true end
  local mf, p5, sp = parts()
  if not mf then kdCM.saved = nil return false, "main form is gone" end
  p5.Visible = s.p5
  sp.Visible = s.sp
  mf.Left, mf.Top, mf.Width, mf.Height = s.L, s.T, s.W, s.H
  kdCM.saved = nil
  return true
end

function kdCM.toggle()
  if kdCM.saved then return kdCM.off() end
  return kdCM.on()
end


local ok, err = kdCM.on()
if not ok then error(tostring(err)) end
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if kdCM then kdCM.off() end
{$asm}
</AssemblerScript></CheatEntry><CheatEntry><ID>9502</ID><Description>"HITCHHIKER EDITOR   [opens a window - writes the SAVE, then load it]"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

--[[ Keep Driving - hitchhiker editor, in Lua, for the cheat table.

Passengers are a 4-seat manager. The save mirrors the in-memory model exactly:

    [hitchhikers]
    hhs            how many passengers are in the car
    hh_N           which hitchhiker sits in seat N, -1 = empty   (N = 0..3)
    hh_level_N     that passenger's level (the game caps it at 3)
    hh_exp_N       experience toward the next level
    hh_blocked_N   seat blocked flag
    hh_picked_up_K whether hitchhiker K has ever been met         (K = 0..14)

This edits the SAVE rather than live memory on purpose. The game owns a
scr_load_hhs routine that rebuilds each passenger's name, portrait, skills and
perks from those fields when a save loads. Writing the in-memory slot_hh array
instead would set the id and leave every piece of derived state stale.

So: close the game (or at least do not let it autosave over you), edit, then
load the save. Every write makes a .bak first.
]]

kdHH = kdHH or {}

-- roster order is the order they appear in hitchhikers.kdr, which IS the id
kdHH.ROSTER = {
  [0] = "suit", [1] = "hippie_girl", [2] = "mechanic", [3] = "hurricane",
  [4] = "punk", [5] = "dog", [6] = "kid", [7] = "songwriter", [8] = "stranger",
  [9] = "idiot", [10] = "convict", [11] = "sleeper", [12] = "hiker",
  [13] = "bride", [14] = "couple",
}
kdHH.COUNT = 15
kdHH.SEATS = 4
kdHH.LEVEL_MAX = 3   -- the seat manager's own level_max
kdHH.FALLBACK = [[D:\Games\Keep.Driving.v1.3.1.1d\savedata\savedata.ini]]


-- Derive &lt;game folder&gt;\savedata\savedata.ini from the attached process, so the
-- table works for anyone who has the game somewhere else.
function kdHH.savePath()
  if kdHH.path and kdHH.path ~= "" then return kdHH.path end
  local ok, mods = pcall(enumModules)
  if ok and type(mods) == "table" then
    for _, m in ipairs(mods) do
      local p = m.PathToFile or ""
      if p:lower():find("keepdriving%.exe") then
        local dir = p:match("^(.*)[\\/][^\\/]+$")
        if dir then
          kdHH.path = dir .. "\\savedata\\savedata.ini"
          return kdHH.path
        end
      end
    end
  end
  kdHH.path = kdHH.FALLBACK
  return kdHH.path
end


-- The editor writes the SAVE. A running game has already loaded its own copy and
-- will autosave over anything written here, so writing while it runs looks like
-- "nothing happened". Refuse instead of failing silently.
function kdHH.gameRunning()
  local ok, pid = pcall(getProcessIDFromProcessName, "KeepDriving.exe")
  if ok and pid and pid ~= 0 then return true, pid end
  return false
end

function kdHH.read()
  local f = io.open(kdHH.savePath(), "rb")
  if not f then return nil, "cannot open " .. kdHH.savePath() end
  local s = f:read("*a")
  f:close()
  return s
end

-- keys always sit at the start of a line, so anchor on the newline: that keeps
-- hh_1 from matching inside hh_picked_up_1 or hh_level_1
local function keypat(key)
  return "\n" .. key .. "=\"([^\"]*)\""
end

function kdHH.get(text, key)
  return text:match(keypat(key))
end

function kdHH.put(text, key, value)
  local pat = "(\n" .. key .. "=\")[^\"]*(\")"
  local new, n = text:gsub(pat, "%1" .. value .. "%2", 1)
  if n == 0 then return text, false end
  return new, true
end

local function num(v)
  return string.format("%.6f", v)
end

function kdHH.state()
  local text, err = kdHH.read()
  if not text then return nil, err end
  local st = { hhs = tonumber(kdHH.get(text, "hhs") or "0") or 0, seats = {} }
  for s = 0, kdHH.SEATS - 1 do
    local id = math.floor(tonumber(kdHH.get(text, "hh_" .. s) or "-1") or -1)
    st.seats[s] = {
      id = id,
      name = (id &gt;= 0 and kdHH.ROSTER[id]) or "empty",
      level = math.floor(tonumber(kdHH.get(text, "hh_level_" .. s) or "0") or 0),
      exp = math.floor(tonumber(kdHH.get(text, "hh_exp_" .. s) or "0") or 0),
    }
  end
  return st
end

function kdHH.describe()
  local st, err = kdHH.state()
  if not st then return "ERROR: " .. tostring(err) end
  local lines = { string.format("passengers: %d", st.hhs) }
  for s = 0, kdHH.SEATS - 1 do
    local e = st.seats[s]
    lines[#lines + 1] = string.format("seat %d: %-12s  level %d", s, e.name, e.level)
  end
  return table.concat(lines, "\n")
end

-- Write the whole seat layout at once. seats = { [0]={id=,level=}, ... }
function kdHH.apply(seats)
  if kdHH.gameRunning() then
    return false, "Keep Driving is running - close it first. While it runs it "
      .. "overwrites this file on every autosave."
  end
  local text, err = kdHH.read()
  if not text then return false, err end
  local clamped = nil

  local missing = {}
  local live = 0
  for s = 0, kdHH.SEATS - 1 do
    local want = seats[s] or { id = -1, level = 0 }
    local id = math.floor(want.id or -1)
    local lvl = math.floor(want.level or 0)
    if id &lt; -1 or id &gt;= kdHH.COUNT then return false, "seat " .. s .. ": id out of range" end
    if id &gt;= 0 then
      -- the game caps levels at level_max; anything else is not a real level
      local fixed = math.max(1, math.min(kdHH.LEVEL_MAX, lvl))
      if fixed ~= lvl then clamped = (clamped or "") .. " seat" .. s .. ":" .. lvl .. "-&gt;" .. fixed end
      lvl = fixed
    end
    local ok1, ok2, ok3, ok4
    text, ok1 = kdHH.put(text, "hh_" .. s, num(id))
    text, ok2 = kdHH.put(text, "hh_level_" .. s, num(id &gt;= 0 and lvl or 0))
    text, ok3 = kdHH.put(text, "hh_exp_" .. s, num(0))
    text, ok4 = kdHH.put(text, "hh_blocked_" .. s, num(0))
    if not (ok1 and ok2 and ok3) then missing[#missing + 1] = "hh_" .. s end
    if id &gt;= 0 then
      live = live + 1
      -- mark them as met so their dialogue/quest state stays consistent
      text = kdHH.put(text, "hh_picked_up_" .. id, num(1))
    end
  end
  if #missing &gt; 0 then
    return false, "these keys are not in the save: " .. table.concat(missing, ", ")
  end
  text = kdHH.put(text, "hhs", num(live))

  local path = kdHH.savePath()
  local src = io.open(path, "rb")
  if src then
    local all = src:read("*a"); src:close()
    local bak = io.open(path .. ".bak", "wb")
    if bak then bak:write(all) bak:close() end
  end
  local out = io.open(path, "wb")
  if not out then return false, "cannot write " .. path end
  out:write(text)
  out:close()
  return true, live, clamped
end

function kdHH.set(seat, id, level)
  local st, err = kdHH.state()
  if not st then return false, err end
  local seats = {}
  for s = 0, kdHH.SEATS - 1 do
    seats[s] = { id = st.seats[s].id, level = st.seats[s].level }
  end
  seats[seat] = { id = id, level = level or 1 }
  return kdHH.apply(seats)
end

function kdHH.clearAll()
  local seats = {}
  for s = 0, kdHH.SEATS - 1 do seats[s] = { id = -1, level = 0 } end
  return kdHH.apply(seats)
end


-- ---------------------------------------------------------------- the window

function kdHH.close()
  if kdHH.watch then
    kdHH.watch.Enabled = false
    kdHH.watch.Destroy()
    kdHH.watch = nil
  end
  if kdHH.form then
    kdHH.form.Destroy()
    kdHH.form = nil
  end
end

-- Live "is the game running" readout. This is the whole reason an edit can look
-- like it did nothing, so it is shown in the window and refreshed once a second,
-- and the writing buttons are disabled while the game is up.
function kdHH.updateGameState()
  if not kdHH.form or not kdHH.live then return end
  local running = kdHH.gameRunning()
  if running then
    kdHH.live.Caption = "Keep Driving is RUNNING  -  close it before step 3"
    kdHH.live.Font.Color = 0x0000C0
  else
    kdHH.live.Caption = "Keep Driving is closed  -  safe to write"
    kdHH.live.Font.Color = 0x008000
  end
  if kdHH.btnWrite then kdHH.btnWrite.Enabled = not running end
  if kdHH.btnEmpty then kdHH.btnEmpty.Enabled = not running end
end

function kdHH.refresh()
  if not kdHH.form then return end
  local st = kdHH.state()
  if not st then return end
  for s = 0, kdHH.SEATS - 1 do
    kdHH.combo[s].ItemIndex = st.seats[s].id + 1      -- row 0 is "(empty)"
    kdHH.lvl[s].Text = tostring(st.seats[s].level)
  end
  kdHH.status.Caption = string.format("passengers in car: %d", st.hhs)
end

function kdHH.show()
  kdHH.close()
  local f = createForm(false)
  f.Caption = "Keep Driving - hitchhikers"
  f.Width = 470
  f.Height = 420
  f.BorderStyle = bsSingle
  kdHH.form = f

  local path = createLabel(f)
  path.Left = 12; path.Top = 8
  path.Caption = "save: " .. kdHH.savePath()

  kdHH.combo, kdHH.lvl = {}, {}
  for s = 0, kdHH.SEATS - 1 do
    local y = 34 + s * 28
    local l = createLabel(f)
    l.Left = 12; l.Top = y + 4; l.Caption = "seat " .. s

    local cb = createComboBox(f)
    cb.Left = 66; cb.Top = y; cb.Width = 190
    cb.Style = csDropDownList
    cb.Items.add("(empty)")
    for i = 0, kdHH.COUNT - 1 do cb.Items.add(i .. "  " .. kdHH.ROSTER[i]) end
    kdHH.combo[s] = cb

    local ll = createLabel(f)
    ll.Left = 266; ll.Top = y + 4; ll.Caption = "level"

    local ed = createEdit(f)
    ed.Left = 302; ed.Top = y; ed.Width = 34
    ed.Text = "1"
    kdHH.lvl[s] = ed
  end

  kdHH.status = createLabel(f)
  kdHH.status.Left = 12; kdHH.status.Top = 152
  kdHH.status.Caption = ""

  local apply = createButton(f)
  apply.Left = 12; apply.Top = 176; apply.Width = 96
  apply.Caption = "Write save"
  kdHH.btnWrite = apply
  apply.OnClick = function()
    local seats = {}
    for s = 0, kdHH.SEATS - 1 do
      local idx = kdHH.combo[s].ItemIndex
      seats[s] = { id = idx - 1, level = tonumber(kdHH.lvl[s].Text) or 1 }
    end
    local ok, res, clamped = kdHH.apply(seats)
    if ok then
      kdHH.status.Caption = "written - " .. res .. " passenger(s). Now do step 4."
        .. (clamped and ("  [level capped:" .. clamped .. "]") or "")
    else
      kdHH.status.Caption = "NOT written: " .. tostring(res)
    end
  end

  local reload = createButton(f)
  reload.Left = 118; reload.Top = 176; reload.Width = 96
  reload.Caption = "Re-read"
  reload.OnClick = kdHH.refresh

  local clr = createButton(f)
  clr.Left = 224; clr.Top = 176; clr.Width = 96
  clr.Caption = "Empty car"
  kdHH.btnEmpty = clr
  clr.OnClick = function()
    for s = 0, kdHH.SEATS - 1 do
      kdHH.combo[s].ItemIndex = 0
      kdHH.lvl[s].Text = "0"
    end
    local ok, res = kdHH.clearAll()
    kdHH.status.Caption = ok and "car emptied - now do step 4"
                              or ("NOT written: " .. tostring(res))
  end

  local cls = createButton(f)
  cls.Left = 330; cls.Top = 176; cls.Width = 80
  cls.Caption = "Close"
  cls.OnClick = kdHH.close

  -- ------------------------------------------------ how to use, in order
  local head = createLabel(f)
  head.Left = 12; head.Top = 212
  head.Font.Style = "fsBold"
  head.Caption = "HOW TO USE  -  the order matters"

  local steps = {
    "1.   Close Keep Driving.  While it runs it overwrites this file,",
    "      so an edit made now would look like it did nothing.",
    "2.   Pick who sits in each seat above.  Level is 1 to 3.",
    "3.   Press  Write save.",
    "4.   Start Keep Driving and pick  Continue  -  they are in the car.",
  }
  for i, line in ipairs(steps) do
    local l = createLabel(f)
    l.Left = 12; l.Top = 236 + (i - 1) * 18
    l.Caption = line
  end

  local note = createLabel(f)
  note.Left = 12; note.Top = 332
  note.Caption = "Removing: set a seat to (empty), or use the game's own kick button."

  local bak = createLabel(f)
  bak.Left = 12; bak.Top = 352
  bak.Caption = "Every write leaves a .bak beside the save."

  kdHH.live = createLabel(f)
  kdHH.live.Left = 12; kdHH.live.Top = 378
  kdHH.live.Font.Style = "fsBold"
  kdHH.live.Caption = ""

  kdHH.refresh()
  kdHH.updateGameState()

  kdHH.watch = createTimer(nil, false)
  kdHH.watch.Interval = 1000
  kdHH.watch.OnTimer = kdHH.updateGameState
  kdHH.watch.Enabled = true

  f.Show()
  return f
end


kdHH.show()
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if kdHH then kdHH.close() end
{$asm}
</AssemblerScript></CheatEntry><CheatEntry>
          <ID>1001</ID>
          <Description>"=== CORE  (verified: aims within seconds) ==="</Description>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>1002</ID>
              <Description>"Money   [needs a transaction/save before it aims]"</Description>
              <VariableType>Double</VariableType>
              <Address>kdP_money</Address>
              <Offsets>
                <Offset>0</Offset>
              </Offsets>
            </CheatEntry>
            <CheatEntry>
              <ID>1003</ID>
              <Description>"Gas / Fuel   [stock 10, tank holds 13]"</Description>
              <VariableType>Double</VariableType>
              <Address>kdP_gas</Address>
              <Offsets>
                <Offset>0</Offset>
              </Offsets>
            </CheatEntry>
            <CheatEntry>
              <ID>1004</ID>
              <Description>"Gas Tank Capacity   [stock 13 - raise before setting Gas higher]"</Description>
              <VariableType>Double</VariableType>
              <Address>kdP_gas_max</Address>
              <Offsets>
                <Offset>0</Offset>
              </Offsets>
            </CheatEntry>
            <CheatEntry>
              <ID>1005</ID>
              <Description>"Energy   [stock 6]"</Description>
              <VariableType>Double</VariableType>
              <Address>kdP_energy</Address>
              <Offsets>
                <Offset>0</Offset>
              </Offsets>
            </CheatEntry>
            <CheatEntry>
              <ID>1006</ID>
              <Description>"Energy Max   [stock 9]"</Description>
              <VariableType>Double</VariableType>
              <Address>kdP_energy_max</Address>
              <Offsets>
                <Offset>0</Offset>
              </Offsets>
            </CheatEntry>
            <CheatEntry>
              <ID>1007</ID>
              <Description>"Energy Max when rested   [stock 10]"</Description>
              <VariableType>Double</VariableType>
